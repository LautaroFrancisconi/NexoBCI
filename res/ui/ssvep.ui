                       <property name="styleSheet">
                        <string notr="true">QSlider::groove:horizontal {
    height: 6px;
    background: #BDBDBD;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #2D89EF;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: white;
    border: 2px solid #2D89EF;
    width: 18px;
    height: 18px;
    margin: -7px 0;    /* centra el círculo sobre la barra */
    border-radius: 9px; /* hace el handle circular */
}

QSlider::handle:horizontal:hover {
    background: #F5F5F5;
}

QSlider::handle:horizontal:pressed {
    background: #E0E0E0;
}</string>
