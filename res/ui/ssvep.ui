              <property name="styleSheet">
               <string notr="true">QListWidget {
    font-family: &quot;Cascadia Mono Extralight&quot;;
    font-size: 12pt;
    color: white;
}

QListWidget {
    background-color: rgba(0, 51, 102, 200);
    color: white;
    border-radius: 10px;
    padding: 5px;
}

/* Cuando pasás el mouse por TODO el cuadro */
QListWidget:hover {
    background-color: rgba(0, 51, 102, 160);
}

/* Ítems normales */
QListWidget::item {
    padding: 8px;
    background-color: transparent;
}

/* Cuando pasás el mouse sobre un ítem */
QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 40);
}

/* Ítem seleccionado */
QListWidget::item:selected {
    background-color: rgb(0, 120, 215);
    color: white;
    border: 2px solid rgb(120, 200, 255);
    border-radius: 6px;
    font-weight: bold;
}
/* Ítem seleccionado + hover (opcional, queda más fluido) */
QListWidget::item:selected:hover {
    background-color: rgb(0, 140, 255);
}</string>
